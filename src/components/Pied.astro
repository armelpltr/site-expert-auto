---
import { ShieldCheck } from '@lucide/astro';
import { site, navigation, telLien } from '@/config/site';
const r = site.reglementaire;
const annee = new Date().getFullYear();
---

<footer class="mt-24 bg-marine text-white/85">
  <div class="conteneur grid gap-10 py-14 text-sm sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="text-lg font-extrabold text-white">{site.enseigne}</p>
      <p class="mt-1">{site.nom}, {site.metier.toLowerCase()} à {site.ville}</p>
      <p class="mt-4">
        <a class="inline-block py-1.5 font-bold text-signal hover:underline" href={telLien}>{site.contact.telephone}</a><br />
        <a class="inline-block py-1.5 hover:underline" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </p>
      {
        site.contact.googleBusinessProfile && (
          <p class="mt-2">
            <a class="hover:underline" href={site.contact.googleBusinessProfile} target="_blank" rel="noopener">
              Avis et fiche Google
            </a>
          </p>
        )
      }
    </div>
    <nav aria-label="Pied de page">
      <ul class="space-y-1">
        {navigation.map((n) => <li><a class="inline-block py-1 hover:text-white hover:underline" href={n.href}>{n.label}</a></li>)}
        <li><a class="inline-block py-1 hover:text-white hover:underline" href="/contact">Contact</a></li>
      </ul>
    </nav>
    <ul class="space-y-1">
      <li><a class="inline-block py-1 hover:text-white hover:underline" href="/mentions-legales">Mentions légales</a></li>
      <li><a class="inline-block py-1 hover:text-white hover:underline" href="/confidentialite">Politique de confidentialité</a></li>
    </ul>
  </div>
  <div class="border-t border-white/15">
    <div class="conteneur grid gap-2 py-5 text-xs text-white/75 md:grid-cols-[auto_1fr] md:items-center md:gap-6">
      <p class="flex items-center gap-2 font-semibold text-white">
        <ShieldCheck size={16} class="text-signal" aria-hidden="true" />
        Liste nationale des experts en automobile : n° {r.numeroListeNationale}
      </p>
      <p>Qualification {r.qualificationVE} · RC professionnelle : {r.assuranceRcPro} · SIRET {r.siret} · © {annee}</p>
    </div>
  </div>
</footer>
