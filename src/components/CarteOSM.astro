---
/** Carte OpenStreetMap intégrée (pas de Google Maps, pas de cookies publicitaires). */
interface Props {
  latitude: number;
  longitude: number;
  titre: string;
  /** Demi-hauteur de la zone affichée, en degrés de latitude. */
  zoom?: number;
}
const { latitude, longitude, titre, zoom = 0.35 } = Astro.props;
const bbox = [longitude - zoom * 1.6, latitude - zoom, longitude + zoom * 1.6, latitude + zoom].map((n) => n.toFixed(5)).join(',');
const src = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${latitude}%2C${longitude}`;
const lien = `https://www.openstreetmap.org/?mlat=${latitude}&mlon=${longitude}#map=10/${latitude}/${longitude}`;
---

<figure>
  <!-- La carte est chargée après la page pour ne pas retarder l'affichage. -->
  <iframe data-src={src} title={titre} referrerpolicy="no-referrer" class="carte-osm aspect-[4/3] w-full rounded-xl border border-trait bg-marine-clair"></iframe>
  <figcaption class="mt-2 text-sm text-encre-douce">
    <a class="lien" href={lien} target="_blank" rel="noopener">Ouvrir la carte sur OpenStreetMap (nouvel onglet)</a>
  </figcaption>
</figure>

<script>
  const charger = () =>
    document.querySelectorAll<HTMLIFrameElement>('iframe.carte-osm[data-src]').forEach((f) => {
      f.src = f.dataset.src!;
      f.removeAttribute('data-src');
    });
  if (document.readyState === 'complete') setTimeout(charger, 300);
  else window.addEventListener('load', () => setTimeout(charger, 300), { once: true });
</script>
