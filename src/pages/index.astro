---
import { Picture } from 'astro:assets';
import { ShieldCheck, Zap, MapPin, Phone, ArrowRight, BadgeCheck } from '@lucide/astro';
import Base from '@/layouts/Base.astro';
import IconePrestation from '@/components/IconePrestation.astro';
import { site, telLien } from '@/config/site';
import { prestationsVisibles, phrasePositionnement } from '@/lib/prestations';
import { entrepriseJsonLd } from '@/lib/jsonld';
import atelier from '@/assets/atelier.jpg';

const prestations = await prestationsVisibles();
const arguments_ = [
  {
    Icone: ShieldCheck,
    titre: 'Indépendance',
    texte: site.positionnement.missionneAssureurs && !site.positionnement.expertAssure
      ? 'Un avis technique impartial, sans lien avec les réparateurs.'
      : 'Aucun lien avec votre assureur ni avec les garages : je défends vos intérêts.',
  },
  { Icone: Zap, titre: 'Réactivité', texte: `Réponse rapide et intervention sous ${site.experience.delaiIntervention}, au garage ou à domicile.` },
  { Icone: MapPin, titre: 'Connaissance du terrain', texte: `${site.experience.annees} ans d’expérience et un réseau local autour de ${site.ville}.` },
];
---

<Base jsonLd={entrepriseJsonLd(Astro.site)}>
  <section class="relative isolate overflow-hidden bg-marine text-white">
    <Picture
      src={atelier}
      alt=""
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-30"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-marine via-marine/90 to-marine/40"></div>
    <div class="conteneur py-16 sm:py-24 lg:py-28">
      <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-sm font-semibold ring-1 ring-white/20">
        <BadgeCheck size={16} class="text-signal" aria-hidden="true" />
        Inscrit sur la liste nationale · n° {site.reglementaire.numeroListeNationale}
      </p>
      <h1 class="mt-6 max-w-3xl text-4xl leading-tight font-extrabold text-white sm:text-5xl lg:text-6xl">
        Expert automobile indépendant à {site.ville}
        <span class="mt-2 block text-signal">
          {site.positionnement.expertAssure ? 'défendez vos droits après un sinistre' : 'un avis technique fiable et impartial'}
        </span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-white/85">{phrasePositionnement()}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="/contact" class="bouton text-lg">Demander une expertise <ArrowRight size={20} aria-hidden="true" /></a>
        <a href={telLien} class="bouton-clair text-lg"><Phone size={20} aria-hidden="true" /> Appeler le {site.contact.telephone}</a>
      </div>
      <p class="mt-4 text-sm text-white/75">Devis gratuit et sans engagement.</p>
    </div>
  </section>

  <section class="conteneur -mt-8 grid gap-4 md:grid-cols-3" aria-label="Pourquoi faire appel à moi">
    {
      arguments_.map(({ Icone, titre, texte }) => (
        <div class="carte relative">
          <span class="grid h-12 w-12 place-items-center rounded-lg bg-signal text-marine">
            <Icone size={24} aria-hidden="true" />
          </span>
          <h2 class="mt-4 text-xl">{titre}</h2>
          <p class="mt-2 text-encre-douce">{texte}</p>
        </div>
      ))
    }
  </section>

  <section class="conteneur mt-24" aria-labelledby="titre-prestations">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="surtitre">Prestations</p>
        <h2 id="titre-prestations" class="mt-2 text-3xl sm:text-4xl">Comment puis-je vous aider ?</h2>
      </div>
      <a href="/prestations" class="lien">Toutes les prestations</a>
    </div>
    <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        prestations.map((p) => (
          <li>
            <a href={`/prestations/${p.id}`} class="carte group flex h-full flex-col hover:-translate-y-0.5 hover:border-signal hover:shadow-md">
              <IconePrestation nom={p.data.icone} class="text-signal-texte" />
              <h3 class="mt-4 text-lg">{p.data.titre}</h3>
              <p class="mt-2 flex-1 text-[0.95rem] text-encre-douce">{p.data.resume}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-bold text-marine-2" aria-hidden="true">
                En savoir plus <ArrowRight size={16} class="transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="conteneur mt-24 grid items-center gap-10 rounded-2xl bg-marine-clair p-8 sm:p-12 lg:grid-cols-[3fr_2fr]">
    <div>
      <h2 class="text-3xl">Sinistre, litige, achat d’occasion ?</h2>
      <p class="mt-4 text-lg text-encre-douce">
        Décrivez votre situation en quelques lignes, joignez vos photos : je vous rappelle pour vous dire si une expertise
        est utile et ce qu’elle vous coûtera.
      </p>
    </div>
    <div class="flex flex-col gap-3">
      <a href="/contact" class="bouton">Demander une expertise</a>
      <a href="/comment-ca-marche" class="bouton-contour">Comment ça marche ?</a>
    </div>
  </section>
</Base>
