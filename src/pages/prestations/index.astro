---
import { ArrowRight } from '@lucide/astro';
import Base from '@/layouts/Base.astro';
import IconePrestation from '@/components/IconePrestation.astro';
import { site } from '@/config/site';
import { prestationsVisibles } from '@/lib/prestations';

const prestations = await prestationsVisibles();
---

<Base titre="Prestations" description={`Expertise après sinistre, contre-expertise, litige garage, vice caché, expertise avant achat, VGE / VEI : les prestations de votre expert automobile à ${site.ville}.`}>
  <div class="conteneur pt-12 sm:pt-16">
    <p class="surtitre">Prestations</p>
    <h1 class="mt-2 text-4xl sm:text-5xl">Mes prestations d’expertise</h1>
    <p class="mt-5 max-w-2xl text-lg text-encre-douce">
      Chaque situation est différente : un premier échange gratuit permet de vérifier si une expertise est utile dans votre cas.
    </p>
  </div>
  <ul class="conteneur mt-10 grid gap-5 sm:grid-cols-2">
    {
      prestations.map((p) => (
        <li>
          <a href={`/prestations/${p.id}`} class="carte group flex h-full gap-5 hover:border-signal hover:shadow-md">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-lg bg-marine text-signal">
              <IconePrestation nom={p.data.icone} size={24} />
            </span>
            <span class="flex flex-col">
              <h2 class="text-lg">{p.data.titre}</h2>
              <span class="mt-2 flex-1 text-[0.95rem] text-encre-douce">{p.data.resume}</span>
              <span class="mt-3 inline-flex items-center gap-1 text-sm font-bold text-marine-2" aria-hidden="true">
                Détails <ArrowRight size={16} class="transition-transform group-hover:translate-x-1" />
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
