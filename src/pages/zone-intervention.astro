---
import { MapPin } from '@lucide/astro';
import Base from '@/layouts/Base.astro';
import CarteOSM from '@/components/CarteOSM.astro';
import { site } from '@/config/site';
import { entrepriseJsonLd } from '@/lib/jsonld';

const villes = site.zone.villes;
---

<Base
  titre="Zone d’intervention"
  description={`Expert automobile à ${site.ville} et alentours : ${villes.slice(0, 8).join(', ')}… Intervention au garage ou à domicile.`}
  jsonLd={entrepriseJsonLd(Astro.site)}
>
  <div class="conteneur pt-12 sm:pt-16">
    <p class="surtitre">Zone d’intervention</p>
    <h1 class="mt-2 text-4xl sm:text-5xl">Expert automobile à {site.ville} et dans le {site.departement}</h1>
    <p class="mt-5 max-w-2xl text-lg text-encre-douce">
      Je me déplace là où se trouve votre véhicule : garage, carrosserie, domicile, parking, fourrière.
      Zone principale : {site.zone.rayon}.
    </p>
  </div>

  <div class="conteneur mt-10 grid gap-10 lg:grid-cols-[3fr_2fr]">
    <CarteOSM latitude={site.contact.latitude} longitude={site.contact.longitude} titre={`Carte de la zone d’intervention autour de ${site.ville}`} />
    <section aria-labelledby="titre-villes">
      <h2 id="titre-villes" class="text-2xl">Communes desservies</h2>
      <ul class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2">
        {
          villes.map((v) => (
            <li class="flex items-center gap-2">
              <MapPin size={16} class="shrink-0 text-signal-texte" aria-hidden="true" />
              {v}
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-encre-douce">{site.zone.deplacementHorsZone}</p>
      <a href="/contact" class="bouton mt-6">Demander une expertise</a>
    </section>
  </div>
</Base>
